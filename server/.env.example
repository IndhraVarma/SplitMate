# ---- Server runtime ----
# Port the Express server listens on. Render injects its own PORT in production.
PORT=5000
# "development" | "production" | "test"
NODE_ENV=development

# ---- Database ----
# MongoDB Atlas SRV connection string. Replace <user>, <password>, <cluster>.
# The database name goes right after the host: .../splitmate?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/splitmate?retryWrites=true&w=majority

# ---- Auth ----
# Long random string used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
# Access token lifetime (zeit/ms format: 15m, 2h, 7d)
JWT_EXPIRES_IN=7d
# bcrypt cost factor
BCRYPT_SALT_ROUNDS=10

# ---- CORS ----
# Comma-separated list of allowed browser origins. No trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Seed script (development only) ----
# Password given to every seeded demo user.
SEED_PASSWORD=Password123!
